#!/bin/sh
# linux-image-__KVER__ postrm: remove what the postinst generated for THIS
# release (DKMS builds, initramfs, module maps). The ESP copy and its rEFInd
# entry are left alone: removing entries is not add-only, and the ESP is the
# operator's (ncz-refind-refresh --list shows it).
set -e
PATH="/usr/sbin:/sbin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin${PATH:+:$PATH}"
KVER="__KVER__"
[ -n "$KVER" ] || exit 0
case "$1" in
    remove|purge)
        if command -v dkms >/dev/null 2>&1; then
            for pv in $(dkms status -k "$KVER" 2>/dev/null | awk -F'[,:]' '{ sub(/[ \t]+$/, "", $1); if ($1 ~ /\//) print $1 }' | sort -u); do
                dkms uninstall -m "${pv%%/*}" -v "${pv#*/}" -k "$KVER" >/dev/null 2>&1 || true
                dkms unbuild -m "${pv%%/*}" -v "${pv#*/}" -k "$KVER" >/dev/null 2>&1 || true
            done
        fi
        rm -f "/boot/initrd.img-$KVER"
        rm -rf "/usr/lib/modules/$KVER/updates/dkms"
        rm -f /usr/lib/modules/"$KVER"/modules.* 2>/dev/null || true
        echo "linux-image-$KVER: removed; its ESP files and rEFInd entry (if staged) were left in place"
        ;;
esac
exit 0
