#!/bin/bash
# SPDX-FileCopyrightText: Copyright (c) 2026 Jason Perlow
# SPDX-License-Identifier: Apache-2.0
#
# ncz-refind-refresh -- stage Sky1 kernels on the rEFInd ESP, ADD-ONLY.
#
# WHY THIS EXISTS
# 2026-11-01 (operator decision): O6N is the CIX Sky1 kernel TEST host. It must
# be able to install a new kernel without ever losing the known-good one. The
# refresh script that cixmini-boot's postinst runs used to wipe the ESP kernels
# and refind.conf, point EVERY menuentry (Default, Rescue, Rescue Partition) at
# the newest kernel and recreate the firmware boot entry with efibootmgr
# -B/-c -- so installing 7.3.1 silently destroyed the 7.3.0 fallback, and it
# re-did all of that on every later apt run.
#
# MODES (the mode is the DEFAULT; there is no flag that picks it):
#
#   add-only (default)   Stage the kernel named by --kver (or the newest one in
#                        /boot that is not staged yet) as ONE extra menuentry
#                        whose options are copied verbatim from the Default
#                        entry. Nothing else is touched: default_selection, the
#                        Rescue entries, the NCZRESCUE entry, the firmware boot
#                        entry and every existing kernel file on the ESP stay
#                        byte-identical. A kernel that is already staged is a
#                        no-op, so the postinst firing on later apt runs costs
#                        nothing and re-writes nothing.
#
#   --promote KVER       The SEPARATE, explicit operator command that makes an
#                        already-staged kernel the default. It changes the
#                        numeric default_selection to that kernel's entry and
#                        nothing else. It never edits a menuentry, never
#                        re-stages a file, never touches the firmware boot
#                        entry. Refused (non-zero, no ESP writes) unless the
#                        kernel is already staged.
#
# PREFLIGHT: the script REFUSES and exits non-zero, before writing anything to
# the ESP, when the ESP is not mounted, when a required tool is missing, when
# refind.conf is absent or malformed, or when neither the new kernel nor the
# known-good kernel it is being staged next to is present in /boot. "Missing
# old known-good files" is a hard error in BOTH modes: add-only is only worth
# anything if the fallback it protects actually exists.
#
# Nothing here calls efibootmgr, reboots, or writes outside the ESP (plus the
# two initramfs outputs in /boot). The firmware boot entry is created once, by
# the install, and is left alone from then on.
#
# LOGGING: every decision is logged to stdout and to /var/log/ncz-refind-refresh.log
# (override with $NCZ_REFIND_LOG; an unwritable log never fails the run).
#
# EXIT CODES: 0 = staged/promoted (or already staged), 2 = usage error,
#             3 = ESP not mounted, 4 = preflight refusal (missing known-good
#             kernel, missing/malformed refind.conf, missing tool), 5 = write
#             failed.
#
# For the O6N install and rollback steps see docs/KERNEL-SIDE-BY-SIDE.md.

set -o pipefail
set -u

PROG=ncz-refind-refresh

# Roots. Every one can be redirected, which is what the shell tests use to
# point the script at a fake ESP + fake /boot; nothing in the tests can see a
# real filesystem, and there is no efibootmgr call anywhere in this file.
ESP=${NCZ_ESP_DIR:-/boot/efi}
BOOT=${NCZ_BOOT_DIR:-/boot}
LOG=${NCZ_REFIND_LOG:-/var/log/ncz-refind-refresh.log}

MODE=add-only
KVER=
NEWEST=0
DRY_RUN=0
# Bumped when the on-disk contract changes; recorded in the log so an operator
# can tell which script staged which entry.
REFRESH_ABI=2

# The hardcoded name of the firmware fallback entry and the sticky rescue
# entry. Neither is ever touched, in any mode.
HARDCODED_NCZRESCUE=NCZRESCUE

usage() {
    cat <<EOF
usage: $PROG [--kver KVER | --newest]          # add-only (default)
       $PROG --promote KVER                    # make KVER the default
       $PROG --list                           # show staged entries, change nothing

  --kver KVER    stage exactly this kernel (default: newest unstaged kernel)
  --newest       stage the newest kernel found in $BOOT that is not staged
  --promote KVER make an already-staged kernel the default (separate command)
  --list         print the staged kernels and the current default_selection
  --dry-run      do everything except write to the ESP
  --esp DIR      ESP mount point (default $ESP)
  --boot DIR     kernel directory (default $BOOT)
  -h, --help     this text
EOF
}

log() {
    printf '%s: %s\n' "$PROG" "$*"
    # A log we cannot write is not a reason to fail the install.
    if [ -n "$LOG" ]; then
        if mkdir -p "$(dirname "$LOG")" 2>/dev/null && : >>"$LOG" 2>/dev/null; then
            printf '%s [%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$MODE" "$*" >>"$LOG" 2>/dev/null || true
        fi
    fi
}

die() {
    local rc="$1"
    shift
    printf '%s: ERROR: %s\n' "$PROG" "$*" >&2
    log "REFUSED: $*"
    exit "$rc"
}

# --- argument parsing -------------------------------------------------------
PROMOTE_KVER=
LIST=0
while [ $# -gt 0 ]; do
    case "$1" in
        --kver)
            [ $# -ge 2 ] || die 2 "--kver needs a kernel version"
            KVER="$2"
            shift 2
            ;;
        --kver=*)
            KVER="${1#--kver=}"
            shift
            ;;
        --promote)
            [ $# -ge 2 ] || die 2 "--promote needs a kernel version"
            PROMOTE_KVER="$2"
            MODE=promote
            shift 2
            ;;
        --promote=*)
            PROMOTE_KVER="${1#--promote=}"
            MODE=promote
            shift
            ;;
        --list)
            LIST=1
            shift
            ;;
        --newest)
            NEWEST=1
            shift
            ;;
        --dry-run)
            DRY_RUN=1
            shift
            ;;
        --esp)
            [ $# -ge 2 ] || die 2 "--esp needs a directory"
            ESP="$2"
            shift 2
            ;;
        --esp=*)
            ESP="${1#--esp=}"
            shift
            ;;
        --boot)
            [ $# -ge 2 ] || die 2 "--boot needs a directory"
            BOOT="$2"
            shift 2
            ;;
        --boot=*)
            BOOT="${1#--boot=}"
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            die 2 "unknown argument: $1 (see --help)"
            ;;
    esac
done

if [ "$MODE" = promote ] && [ -z "$PROMOTE_KVER" ]; then
    die 2 "--promote needs a kernel version"
fi
if [ "$MODE" = promote ] && [ "$NEWEST" = 1 ]; then
    die 2 "--promote and --newest are mutually exclusive"
fi

ESP_REAL=$(readlink -f "$ESP" 2>/dev/null || printf '%s' "$ESP")

# --- ESP layout discovery ---------------------------------------------------
#
# There are two rEFInd layouts in the field and this script has to handle both.
# O6N, the Sky1 kernel test host, is the second one:
#
#   legacy (installed from an older NCZ image)
#     refind.conf   $ESP/EFI/refind/refind.conf
#     kernels       $ESP/EFI/ncz/ncz-<KVER>/{vmlinuz,initrd.img,sky1-orion-o6.dtb}
#     entries       menuentry "NCZ <KVER>"  (default_selection is an index)
#
#   O6N / removable-media BOOT (what the current image installs)
#     refind.conf   $ESP/EFI/BOOT/refind.conf   (BOOTAA64.EFI, use_nvram false)
#     kernels       $ESP/vmlinuz-<KVER>, $ESP/initrd.img-<KVER>  (the ESP ROOT)
#     entries       menuentry "NCZ-OS 26.10 Cygnus  -  7.3 Mali (Default)",
#                   i.e. a display name, and default_selection is the quoted
#                   TITLE STRING "7.3 Mali (Default)" -- a substring of the
#                   menuentry title, not an index and not "NCZ <KVER>".
#
# The layout is DISCOVERED from the ESP, never guessed from the kernel name:
# whichever of EFI/refind/refind.conf or EFI/BOOT/refind.conf exists decides
# where the config lives and, with it, where the new kernel's files go. A host
# with both prefers EFI/refind (the older, more explicit install). NCZ_LAYOUT
# may be pinned to legacy|boot for tests and for a host that has both.
discover_layout() {
    local want="${NCZ_LAYOUT:-}" cand
    for cand in "$ESP_REAL/EFI/refind" "$ESP_REAL/EFI/BOOT"; do
        [ -f "$cand/refind.conf" ] || continue
        case "$cand" in
            */EFI/BOOT)
                [ "$want" = legacy ] && continue
                LAYOUT=boot
                ;;
            *)
                [ "$want" = boot ] && continue
                LAYOUT=legacy
                ;;
        esac
        REFIND_DIR="$cand"
        return 0
    done
    return 1
}

LAYOUT=
REFIND_DIR=
REFIND_CONF=
KERNEL_DIR=
if discover_layout; then
    REFIND_CONF="$REFIND_DIR/refind.conf"
fi
# Where the ESP keeps a kernel's files. Legacy: one directory per version, so
# several versions coexist and no version's files are ever overwritten.
# O6N: at the ESP root, named after the kernel, exactly like 7.3.0 already is.
KERNEL_DIR="$ESP_REAL/EFI/ncz"
kernel_stage_dir() { printf '%s/ncz-%s' "$KERNEL_DIR" "$1"; }
kernel_files_prefix() {
    case "${LAYOUT:-legacy}" in
        boot) printf '%s' "$ESP_REAL" ;;
        *) printf '%s' "$(kernel_stage_dir "$1")" ;;
    esac
}
# The on-ESP filename of a kernel's vmlinuz / initrd / dtb for this layout.
esp_kernel_name() {
    case "${LAYOUT:-legacy}" in
        boot) printf '%s-%s' "$2" "$1" ;;
        *) printf '%s' "$2" ;;
    esac
}

# The names a staged kernel is copied to. Legacy: renames inside its own
# version directory (rEFInd resolves those paths relative to an unchanged
# prefix). The O6N layout uses the same /vmlinuz-<KVER> and /initrd.img-<KVER>
# names the known-good entry already uses, so the two kernels coexist and a new
# install can never shadow the running one.
STAGE_VMLINUZ=vmlinuz
STAGE_INITRD=initrd.img
STAGE_DTB=sky1-orion-o6.dtb

# The icon the appended entry uses. O6N's entries use /EFI/BOOT/ncz.png; the
# legacy layout uses the rEFInd theme icon. Purely cosmetic, but keeping a new
# entry consistent with its neighbours matters on a graphical boot menu.
case "${LAYOUT:-legacy}" in
    boot) entry_icon=/EFI/BOOT/ncz.png ;;
    *) entry_icon=/EFI/refind/icons/os_linux.png ;;
esac

# --- preflight --------------------------------------------------------------
# Refuse when discovery found no rEFInd configuration at all. The message
# names BOTH supported locations so an operator can see what was looked for.
check_refind_present() {
    [ -n "$REFIND_CONF" ] && [ -d "$REFIND_DIR" ] && return 0
    die 4 "no rEFInd on the ESP (looked for $ESP_REAL/EFI/refind/refind.conf and $ESP_REAL/EFI/BOOT/refind.conf); refusing: no ESP writes"
}

check_esp_mounted() {
    # Test-only escape hatch: honoured solely together with an explicit
    # NCZ_ESP_DIR override, so it can never relax the check on a real host.
    if [ "${NCZ_ESP_SKIP_MOUNT_CHECK:-0}" = "1" ] && [ -n "${NCZ_ESP_DIR:-}" ]; then
        check_refind_present
        return 0
    fi
    local mnt
    mnt=$(awk -v p="$ESP_REAL" '$2 == p { print $2; exit }' /proc/mounts 2>/dev/null)
    if [ -z "$mnt" ] && [ -f /proc/mounts ]; then
        # Fall back to resolving symlinks (a bind mount or a test harness).
        local cand
        while read -r _dev cand _rest; do
            if [ "$(readlink -f "$cand" 2>/dev/null)" = "$ESP_REAL" ]; then
                mnt=$cand
                break
            fi
        done </proc/mounts
    fi
    [ -n "$mnt" ] || die 3 "ESP is not mounted at $ESP_REAL (refusing: no ESP writes)"
    check_refind_present
}

# Refuse on a refind.conf we cannot safely edit. Both modes need an intact
# configuration: add-only appends to it, promote edits one line of it.
check_refind_conf() {
    check_refind_present
    [ -f "$REFIND_CONF" ] || die 4 "$REFIND_CONF missing (refusing: no ESP writes)"
    [ -r "$REFIND_CONF" ] || die 4 "$REFIND_CONF not readable (refusing: no ESP writes)"
    # Braces must balance, otherwise a naive append would land inside a block.
    local opens closes
    opens=$(grep -o '{' "$REFIND_CONF" | wc -l)
    closes=$(grep -o '}' "$REFIND_CONF" | wc -l)
    [ "$opens" = "$closes" ] || die 4 "$REFIND_CONF has unbalanced braces ($opens open, $closes close); refusing"
    grep -qE '^[[:space:]]*menuentry[[:space:]]' "$REFIND_CONF" || \
        die 4 "$REFIND_CONF has no menuentry (refusing: not a rEFInd config)"
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die 4 "required tool '$1' not found"
}

# --- /boot side -------------------------------------------------------------
# The Yocto kernel package installs /boot/Image-<KVER>, not /boot/vmlinuz-<KVER>
# (see docs/kernel-7.3.0-final-20261019/PARKED-O6N-BOOT-VALIDATION-20261020.md).
# Accept both, plus the /boot/vmlinuz-<KVER> compat symlink.
kernel_image() {
    local kver="$1"
    local f
    for f in "$BOOT/vmlinuz-$kver" "$BOOT/Image-$kver"; do
        if [ -f "$f" ]; then
            printf '%s\n' "$f"
            return 0
        fi
    done
    return 1
}

kernel_initrd() {
    local kver="$1"
    local f
    for f in "$BOOT/initrd.img-$kver" "$BOOT/initrd-$kver"; do
        if [ -f "$f" ]; then
            printf '%s\n' "$f"
            return 0
        fi
    done
    return 1
}

kernel_dtb() {
    local kver="$1"
    local f
    for f in "$BOOT/cix/sky1-orion-o6.dtb" "$BOOT/dtb-$kver/cix/sky1-orion-o6.dtb"; do
        if [ -f "$f" ]; then
            printf '%s\n' "$f"
            return 0
        fi
    done
    return 1
}

# Every KVER that has a kernel image in /boot, newest first.
list_boot_kvers() {
    local f base
    for f in "$BOOT"/vmlinuz-* "$BOOT"/Image-*; do
        [ -e "$f" ] || continue
        base=$(basename "$f")
        base=${base#vmlinuz-}
        base=${base#Image-}
        printf '%s\n' "$base"
    done | sort -u -V -r
}

# Is this KVER already staged, i.e. does the ESP hold its kernel files and a
# menuentry that points at them? "Staged" is layout-specific: legacy wants the
# version directory plus an "NCZ <KVER>" entry; the O6N layout wants
# /vmlinuz-<KVER> at the ESP root plus an entry that loads it.
is_staged() {
    local kver="$1"
    case "${LAYOUT:-legacy}" in
        boot)
            [ -f "$ESP_REAL/$(esp_kernel_name "$kver" vmlinuz)" ] || return 1
            grep -qF "/$(esp_kernel_name "$kver" vmlinuz)" "$REFIND_CONF" || return 1
            ;;
        *)
            [ -d "$(kernel_stage_dir "$kver")" ] || return 1
            # The directory alone is not enough: an entry whose menuentry was
            # deleted would report as staged and never be re-added. Require the
            # "NCZ <KVER>" entry too, exactly as the header documents.
            [ -n "$(entry_index_for_kver "$kver")" ] || return 1
            ;;
    esac
    return 0
}

# The menuentry title this script uses for a kernel it stages. The O6N layout
# names entries after the display name (e.g. "... - 7.3 Mali (Default)"), so a
# new entry gets a self-describing variant of the SAME shape, and
# default_selection keeps naming a title; the legacy layout keeps "NCZ <KVER>".
new_entry_title() {
    local kver="$1"
    case "${LAYOUT:-legacy}" in
        boot) printf 'NCZ-OS 26.10 Cygnus  -  %s (Side-by-side)' "$kver" ;;
        *) printf 'NCZ %s' "$kver" ;;
    esac
}

# 0-based index of the menuentry that stages $1 in THIS layout (empty when the
# kernel is not staged). Legacy matches the "NCZ <KVER>" title; the O6N layout
# matches the entry that loads /vmlinuz-<KVER>, whatever its display title.
entry_index_for_staged_kver() {
    local kver="$1"
    case "${LAYOUT:-legacy}" in
        boot)
            # Walk the entries: an entry "hits" when its loader or initrd line
            # names this kernel's ESP-root file. The index counts menuentry
            # lines in file order, the same way rEFInd does.
            #
            # The match is a FIXED-STRING comparison, not a regex: a KVER
            # contains dots, so `$0 ~ (".../vmlinuz-" want)` would treat them
            # as wildcards and let 6.8.0 match 6x8y0 (a wrong entry index).
            # The path is the FIRST token after the directive (rEFInd allows
            # further parameters on the same line), optionally quoted, and it
            # is compared byte-for-byte.
            awk -v want="/$(esp_kernel_name "$kver" vmlinuz)" '
                BEGIN { idx = 0; hit = 0 }
                function is_ours(line,   p) {
                    if (!match(line, /^[[:space:]]*(loader|initrd)[[:space:]]+/))
                        return 0
                    p = substr(line, RLENGTH + 1)
                    sub(/^"/, "", p)
                    sub(/".*$/, "", p)
                    sub(/[[:space:]].*$/, "", p)
                    return p == want
                }
                /^[[:space:]]*menuentry[[:space:]]/ {
                    if (hit) { print idx - 1; found = 1; exit }
                    idx++; hit = 0; next
                }
                /^[[:space:]]*}/ { next }
                is_ours($0) { hit = 1 }
                END {
                    if (found) exit 0
                    if (hit) { print idx - 1; exit 0 }
                    exit 1
                }
            ' "$REFIND_CONF"
            ;;
        *) entry_index_for_kver "$kver" ;;
    esac
}

# The Default entry's option string, verbatim. This is what the new entry
# inherits, so a new kernel boots with EXACTLY the known-good kernel's
# parameters -- no drift in cmdline between versions.
#
# Which entry is "the Default"? NOT simply whatever default_selection names:
# on O6N default_selection can point at a rescue entry (or be "last"), and
# inheriting a rescue entry's options (e.g. "ro single ncz_rescue=1") would
# give the new kernel a rescue cmdline. The Default is therefore the
# known-good NCZ kernel entry, resolved in this order:
#
#   1. an explicit menuentry titled "Default", if the config has one;
#   2. the NCZ <KVER> entry named by default_selection (via default_kver),
#      skipping any Rescue / Rescue Partition / NCZRESCUE entry;
#   3. otherwise: refuse. Never fall back to "the first menuentry" -- on O6N
#      the first entries ARE the rescue ones.
default_entry_options() {
    local idx
    if [ "${LAYOUT:-legacy}" = boot ]; then
        idx=$(o6n_default_index)
    else
        idx=$(entry_index_for_title "Default")
        [ -n "$idx" ] || idx=$(default_kernel_index)
    fi
    [ -n "$idx" ] || return 1
    entry_options_at_index "$idx"
}

# --- O6N (EFI/BOOT) layout: resolve the Default entry ----------------------
#
# In this layout entries are titled after the display name, and
# default_selection is a TITLE STRING, e.g.
#
#     default_selection "7.3 Mali (Default)"
#     menuentry "NCZ-OS 26.10 Cygnus  -  7.3 Mali (Default)" { ... }
#
# rEFInd matches default_selection as a title SUBSTRING, so the selection is
# the quoted fragment of the menuentry title, not the whole title and not an
# index. Resolution order for "the Default entry whose options a new kernel
# inherits":
#
#   1. the menuentry whose title CONTAINS the default_selection string;
#   2. the menuentry whose title contains "(Default)";
#   3. otherwise: refuse (return non-zero). Never take "the first entry": on
#      O6N the rescue variants are ordinary entries in the same file, and a
#      rescue cmdline must never leak into a normal kernel.
#
# Rescue variants ("Rescue", "Rescue Partition", "No Accelerators") are skipped
# at every step even if they are what default_selection happens to name.

# Is the given menuentry title line a rescue variant?
o6n_title_is_rescue() {
    case "$1" in
        *[Rr]escue*) return 0 ;;
        *NCZRESCUE*) return 0 ;;
        *"No Accelerators"*) return 0 ;;
    esac
    return 1
}

# 0-based index of the first non-rescue menuentry whose title matches the
# shell glob-like awk regex $1 (empty output when none matches).
#
# Rescue variants are skipped HERE, not only at the call sites: the matching
# helpers are what the "(Default)" search walks, and a rescue entry whose
# title merely contains the substring being looked for must never be returned
# -- a rescue cmdline leaking into a normal kernel is the exact failure this
# whole section exists to prevent.
o6n_entry_index_matching() {
    awk -v want="$1" '
        BEGIN { idx = 0 }
        function title_of(line,   t) {
            t = line
            sub(/^[[:space:]]*menuentry[[:space:]]+/, "", t)
            sub(/^"/, "", t)
            sub(/".*$/, "", t)
            return t
        }
        function is_rescue(t) {
            return (t ~ /[Rr]escue/) || (t ~ /NCZRESCUE/) || (t ~ /No Accelerators/)
        }
        /^[[:space:]]*menuentry[[:space:]]/ {
            t = title_of($0)
            if (!is_rescue(t) && t ~ want) { print idx; exit }
            idx++
        }
    ' "$REFIND_CONF"
}

o6n_default_index() {
    local sel rgx idx
    sel=$(current_default_selection)
    # 1. Whatever default_selection names, if it names a non-rescue entry.
    if [ -n "$sel" ] && [ "$sel" != last ] && ! o6n_title_is_rescue "$sel"; then
        rgx=$(printf '%s' "$sel" | sed 's/[][\\.^$*+?(){}|]/\\&/g')
        idx=$(o6n_entry_index_matching "$rgx")
        [ -n "$idx" ] && { printf '%s\n' "$idx"; return 0; }
    fi
    # 2. The entry explicitly marked "(Default)".
    idx=$(o6n_entry_index_matching '\\(Default\\)')
    [ -n "$idx" ] && { printf '%s\n' "$idx"; return 0; }
    return 1
}

# The KVER a staged O6N entry boots: the kernel named in its loader line, e.g.
# loader /vmlinuz-7.3.0-sky1-ncz -> 7.3.0-sky1-ncz. Prints NOTHING when the
# entry's loader is not an ESP-root /vmlinuz-<KVER> -- the caller must see an
# empty result, never a loader path passed off as a kernel version.
o6n_kver_at_index() {
    awk -v want="$1" '
        BEGIN { idx = 0 }
        /^[[:space:]]*menuentry[[:space:]]/ { in_entry = (idx == want); idx++; next }
        in_entry && /^[[:space:]]*loader[[:space:]]/ {
            l = $0
            sub(/^[[:space:]]*loader[[:space:]]+/, "", l)
            sub(/^"/, "", l); sub(/".*$/, "", l)
            # Only an ESP-root /vmlinuz-<KVER> names a kernel version. Anything
            # else (a nested path, a different name) yields no KVER at all.
            if (sub(/^\/vmlinuz-/, "", l)) print l
            exit
        }
    ' "$REFIND_CONF"
}

# Options line of the menuentry at 0-based index $1, verbatim.
entry_options_at_index() {
    awk -v want="$1" '
        /^[[:space:]]*menuentry[[:space:]]/ { depth = 0; in_entry = 1; opened = 0; in_target = (idx == want); idx++; next }
        in_entry && !opened {
            o = $0
            n_open = gsub(/{/, "{", o)
            o = $0
            n_close = gsub(/}/, "}", o)
            opened = 1
            depth = 1 + n_open - n_close
            if (in_target && !seen && /^[[:space:]]*options[[:space:]]/) {
                sub(/^[[:space:]]*options[[:space:]]+/, "")
                seen = 1
                opts = $0
            }
            next
        }
        in_entry {
            o = $0
            n_open = gsub(/{/, "{", o)
            o = $0
            n_close = gsub(/}/, "}", o)
            depth += n_open - n_close
            if (in_target && !seen && /^[[:space:]]*options[[:space:]]/) {
                sub(/^[[:space:]]*options[[:space:]]+/, "")
                seen = 1
                opts = $0
            }
            if (depth <= 0) { in_entry = 0; in_target = 0 }
        }
        END { if (seen) print opts; else exit 1 }
    ' "$REFIND_CONF"
}

# 0-based index of the menuentry whose title is exactly $1.
entry_index_for_title() {
    awk -v want="$1" '
        BEGIN { idx = 0 }
        /^[[:space:]]*menuentry[[:space:]]/ {
            title = extract_title($0)
            if (title == want) { print idx; exit }
            idx++
        }
        function extract_title(line,   t) {
            # menuentry "TITLE" [, "PARAMS"] { ... } -> TITLE
            t = line
            sub(/^[[:space:]]*menuentry[[:space:]]+[^"]*"/, "", t)
            sub(/".*$/, "", t)
            return t
        }
    ' "$REFIND_CONF"
}

current_default_selection() {
    awk '
        /^[[:space:]]*default_selection[[:space:]]/ {
            v = $0
            sub(/^[[:space:]]*default_selection[[:space:]]+/, "", v)
            if (v ~ /^"/) { sub(/^"/, "", v); sub(/".*$/, "", v) }
            else { sub(/[[:space:]].*$/, "", v) }
            print v
            exit
        }
    ' "$REFIND_CONF"
}

# 0-based index of the "NCZ <KVER>" menuentry (empty when not present).
entry_index_for_kver() {
    entry_index_for_title "NCZ $1"
}

# 0-based index of the entry that carries the "Default kernel" cmdline -- the
# NCZ kernel the operator is currently booting. default_selection is honoured
# when it names an NCZ entry, but a *rescue* selection (or "last"/unset) must
# not defeat the lookup: in that case fall back to the LAST "NCZ <KVER>"
# menuentry, i.e. the most recently installed kernel, which is the known-good
# one. Rescue / Rescue Partition / NCZRESCUE entries are never candidates.
default_kernel_index() {
    local sel idx title
    sel=$(current_default_selection)
    case "$sel" in
        '' | last) : ;;
        *[!0-9]*)
            idx=$(entry_index_for_title "$sel")
            ;;
        *)
            idx=$sel
            ;;
    esac
    if [ -n "$idx" ]; then
        title=$(entry_title_at_index "$idx")
        case "$title" in
            "NCZ "*) printf '%s\n' "$idx"; return 0 ;;
        esac
    fi
    # default_selection did not name an NCZ kernel (it named a rescue entry,
    # "last", an index out of range, or is absent). The known-good kernel is
    # then the *highest version* NCZ entry: version sort, not file order, so
    # a config whose entries were appended out of order still resolves right.
    awk '
        /^[[:space:]]*menuentry[[:space:]]/ {
            t = $0
            sub(/^[[:space:]]*menuentry[[:space:]]+[^"]*"/, "", t)
            sub(/".*$/, "", t)
            if (t ~ /^NCZ /) {
                v = t
                sub(/^NCZ /, "", v)
                n++
                ver[n] = v; idxs[n] = idx
            }
            idx++
        }
        END {
            if (n == 0) exit 1
            best = 1
            for (i = 2; i <= n; i++)
                if (vercmp(ver[i], ver[best]) > 0) best = i
            print idxs[best]
        }
        # Numeric-aware version compare: split on - and ., compare numerics
        # numerically and the rest lexically, so 7.3.1 > 7.3.0 and
        # 7.3.10 > 7.3.9.
        function vercmp(a, b,   A, B, i, n, x, y) {
            n = split(a, A, /[-.]/)
            split(b, B, /[-.]/)
            for (i = 1; i <= n; i++) {
                if (A[i] == "" || B[i] == "") continue
                x = A[i]; y = B[i]
                if (x ~ /^[0-9]+$/ && y ~ /^[0-9]+$/) {
                    if (x + 0 != y + 0) return (x + 0 > y + 0) ? 1 : -1
                } else {
                    if (x != y) return (x > y) ? 1 : -1
                }
            }
            return 0
        }
    ' "$REFIND_CONF"
}

# Title of the menuentry at 0-based index $1 (empty when out of range).
entry_title_at_index() {
    awk -v want="$1" '
        BEGIN { idx = 0 }
        /^[[:space:]]*menuentry[[:space:]]/ {
            if (idx == want) {
                t = $0
                sub(/^[[:space:]]*menuentry[[:space:]]+[^"]*"/, "", t)
                sub(/".*$/, "", t)
                print t
                exit
            }
            idx++
        }
    ' "$REFIND_CONF"
}

# The currently promoted kernel = the kernel named by default_selection. This
# is the "known-good" kernel that add-only mode must protect. Empty when the
# default does not resolve to an "NCZ <KVER>" entry.
default_kver() {
    local idx title kver
    if [ "${LAYOUT:-legacy}" = boot ]; then
        # In this layout the KVER is not in the title; it is in the loader line
        # (/vmlinuz-<KVER>), which is exactly what the entry boots.
        idx=$(o6n_default_index) || { printf '\n'; return 0; }
        [ -n "$idx" ] || { printf '\n'; return 0; }
        o6n_kver_at_index "$idx" || printf '\n'
        return 0
    fi
    idx=$(default_kernel_index) || { printf '\n'; return 0; }
    [ -n "$idx" ] || { printf '\n'; return 0; }
    title=$(entry_title_at_index "$idx")
    case "$title" in
        "NCZ "*) printf '%s\n' "${title#NCZ }" ;;
        *) printf '\n' ;;
    esac
}

# --- modes ------------------------------------------------------------------
stage_new_kernel() {
    local kver="$1" img initrd dtb stage opts
    img=$(kernel_image "$kver") || die 4 "no kernel image for $kver in $BOOT (/boot/vmlinuz-$kver or /boot/Image-$kver); refusing: no ESP writes"
    initrd=$(kernel_initrd "$kver") || \
        die 4 "no initramfs for $kver in $BOOT (run update-initramfs -c -k $kver); refusing: no ESP writes"

    if is_staged "$kver"; then
        log "$kver is already staged on the ESP -- nothing to do (add-only)"
        return 0
    fi

    local known_good
    known_good=$(default_kver)
    if [ -n "$known_good" ]; then
        local kg_img
        if ! kg_img=$(kernel_image "$known_good"); then
            die 4 "known-good kernel $known_good has no image in $BOOT; refusing: the fallback would be lost"
        fi
        is_staged "$known_good" || \
            die 4 "known-good kernel $known_good is not staged on the ESP; refusing: the fallback would be lost"
        log "known-good kernel $known_good present and staged -- it will not be touched"
    else
        log "WARNING: no default kernel resolved (layout $LAYOUT); staging $kver without a resolved fallback"
    fi

    opts=$(default_entry_options) || \
        die 4 "the Default menuentry in $REFIND_CONF has no options line; refusing: cannot copy its options"
    log "Default entry options copied verbatim: $opts"

    if [ "$DRY_RUN" = 1 ]; then
        log "DRY RUN: would stage $kver from $img -> $(kernel_files_prefix "$kver")/$(esp_kernel_name "$kver" vmlinuz) (initrd $initrd)"
        log "DRY RUN: refind.conf left unchanged"
        return 0
    fi

    local dst_v dst_i dst_d title
    dst_v="$(kernel_files_prefix "$kver")/$(esp_kernel_name "$kver" vmlinuz)"
    dst_i="$(kernel_files_prefix "$kver")/$(esp_kernel_name "$kver" initrd.img)"
    dst_d="$(kernel_files_prefix "$kver")/$(esp_kernel_name "$kver" sky1-orion-o6.dtb)"
    title=$(new_entry_title "$kver")

    # Refuse rather than clobber: if a destination file already exists but the
    # kernel is not staged (no menuentry), something else owns that name. The
    # O6N layout writes NEW files only -- vmlinuz-<KVER>/initrd.img-<KVER> for
    # this KVER -- so an existing one is never the running kernel's.
    local f
    for f in "$dst_v" "$dst_i" "$dst_d"; do
        [ -e "$f" ] && die 5 "$f exists but $kver is not staged; refusing to overwrite an unowned ESP file"
    done

    if [ "$LAYOUT" != boot ]; then
        mkdir -p "$(kernel_files_prefix "$kver")" || die 5 "cannot create $(kernel_files_prefix "$kver")"
    fi
    cp -f "$img" "$dst_v" || die 5 "cannot copy $img to $dst_v"
    cp -f "$initrd" "$dst_i" || die 5 "cannot copy $initrd to $dst_i"
    if dtb=$(kernel_dtb "$kver"); then
        cp -f "$dtb" "$dst_d" || die 5 "cannot copy $dtb to $dst_d"
        log "staged $kver: $(basename "$img"), $(basename "$initrd"), $(basename "$dtb")"
    else
        log "WARNING: no sky1-orion-o6.dtb for $kver; entry will not set a device tree"
        log "staged $kver: $(basename "$img"), $(basename "$initrd")"
    fi
    sync -f "$dst_v" 2>/dev/null || sync

    # APPEND one entry. Never rewrite, never reorder, never touch an existing
    # entry: refind.conf keeps its existing bytes as a strict prefix.
    {
        printf '\n'
        printf '# --- added by %s: kernel %s, ADD-ONLY (not the default) ---\n' "$PROG" "$kver"
        printf 'menuentry "%s" {\n' "$title"
        printf '    icon %s\n' "$entry_icon"
        printf '    volume ncz\n'
        printf '    loader %s\n' "${dst_v#"$ESP_REAL"}"
        printf '    initrd %s\n' "${dst_i#"$ESP_REAL"}"
        if [ -f "$dst_d" ]; then
            printf '    devicetree %s\n' "${dst_d#"$ESP_REAL"}"
        fi
        printf '    options %s\n' "$opts"
        printf '}\n'
    } >>"$REFIND_CONF" || die 5 "cannot append the $kver menuentry to $REFIND_CONF"

    log "added menuentry \"$title\"; default_selection is UNCHANGED ($(current_default_selection))"
    log "to make it the default run: $PROG --promote $kver"
}

promote_kernel() {
    local kver="$1"
    kernel_image "$kver" >/dev/null || \
        die 4 "no kernel image for $kver in $BOOT; refusing: will not promote a kernel that is not installed"
    is_staged "$kver" || \
        die 4 "$kver is not staged on the ESP; refusing: run '$PROG --kver $kver' first"

    local idx cur new_sel
    idx=$(entry_index_for_staged_kver "$kver")
    [ -n "$idx" ] || die 4 "no menuentry in $REFIND_CONF loads $kver; refusing"
    cur=$(current_default_selection)

    # What default_selection must say. In the O6N layout default_selection is a
    # quoted TITLE, so promote writes this entry's title (the same syntax the
    # existing "7.3 Mali (Default)" line uses); a bare index there would be
    # read by rEFInd as a numeric position, not as this kernel. The legacy
    # layout keeps the numeric index it has always used.
    if [ "$LAYOUT" = boot ]; then
        local t
        t=$(entry_title_at_index "$idx")
        [ -n "$t" ] || die 4 "cannot read the title of entry $idx in $REFIND_CONF; refusing"
        new_sel="\"$t\""
        # current_default_selection() always returns the UNQUOTED title, so
        # compare unquoted-to-unquoted rather than relying on the quote form of
        # the existing line. Normalise both sides to the bare title.
        local cur_unq="${cur#\"}"; cur_unq="${cur_unq%\"}"
        if [ "$cur_unq" = "$t" ] || [ "$cur" = "$t" ]; then
            log "default_selection already selects $kver -- nothing to do"
            return 0
        fi
    else
        new_sel="$idx"
        if [ "$cur" = "$new_sel" ]; then
            log "default_selection already selects $kver -- nothing to do"
            return 0
        fi
    fi

    if [ "$DRY_RUN" = 1 ]; then
        log "DRY RUN: would set default_selection from $cur to $new_sel ($kver)"
        return 0
    fi

    # Exactly one line changes. Every menuentry, the rescue entries and the
    # firmware boot entry are untouched.
    #
    # The value is passed through the ENVIRONMENT and read with ENVIRON[]
    # rather than `awk -v`: -v interprets backslash escapes (\t -> tab, \n ->
    # newline) in the value, which would corrupt a title containing one. A
    # title is opaque text and must be written back byte-for-byte.
    # NCZ_PROMOTE_SEL=... awk is a prefix assignment: it reaches the command's
    # environment without `export` (POSIX), so ENVIRON sees it.
    local tmp
    tmp=$(mktemp "$REFIND_DIR/.refind.conf.XXXXXX") || die 5 "cannot create a temp file in $REFIND_DIR"
    if NCZ_PROMOTE_SEL="$new_sel" awk '
        BEGIN { want = ENVIRON["NCZ_PROMOTE_SEL"] }
        !done && /^[[:space:]]*default_selection[[:space:]]/ {
            printf "default_selection %s\n", want
            done = 1
            next
        }
        { print }
        END { exit (done ? 0 : 1) }
    ' "$REFIND_CONF" >"$tmp"; then
        cat "$tmp" >"$REFIND_CONF" || { rm -f "$tmp"; die 5 "cannot write $REFIND_CONF"; }
        rm -f "$tmp"
    else
        rm -f "$tmp"
        die 4 "no default_selection line in $REFIND_CONF; refusing (add one by hand first)"
    fi
    sync -f "$REFIND_CONF" 2>/dev/null || sync
    log "PROMOTED $kver: default_selection $cur -> $new_sel; menuentries, rescue entries and the firmware boot entry unchanged"
}

list_staged() {
    local kver
    log "ESP: $ESP_REAL (layout $LAYOUT, config $REFIND_CONF)"
    log "default_selection: $(current_default_selection)"
    for kver in $(list_boot_kvers); do
        if is_staged "$kver"; then
            log "  $kver  staged (entry $(entry_index_for_staged_kver "$kver"))"
        else
            log "  $kver  in $BOOT, not staged"
        fi
    done
}

# --- main -------------------------------------------------------------------
case "$MODE" in
    promote)
        require_cmd awk
        check_esp_mounted
        check_refind_conf
        log "mode: promote ($PROMOTE_KVER)"
        promote_kernel "$PROMOTE_KVER"
        ;;
    *)
        if [ "$LIST" = 1 ]; then
            check_esp_mounted
            check_refind_conf
            list_staged
            exit 0
        fi
        require_cmd awk
        require_cmd cp
        check_esp_mounted
        check_refind_conf
        if [ -z "$KVER" ]; then
            # Newest kernel in /boot that is not staged yet -- that is the one
            # the package manager just dropped. Already-staged kernels are
            # skipped, so a later apt run does not re-add an entry.
            for cand in $(list_boot_kvers); do
                if ! is_staged "$cand"; then
                    KVER=$cand
                    break
                fi
            done
            if [ -z "$KVER" ]; then
                log "no unstaged kernel in $BOOT -- nothing to do (add-only)"
                exit 0
            fi
            log "no --kver given: picked the newest unstaged kernel $KVER"
        fi
        log "mode: add-only ($KVER)"
        stage_new_kernel "$KVER"
        ;;
esac
