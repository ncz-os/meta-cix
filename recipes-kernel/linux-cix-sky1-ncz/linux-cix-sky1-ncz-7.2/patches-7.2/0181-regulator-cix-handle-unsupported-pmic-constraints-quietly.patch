From c3e4bc339c067dc19f4cffa2a623c38a13bfb37a Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Mon, 14 Sep 2026 18:09:29 -0400
Subject: [PATCH 4/6] regulator: cix: handle unsupported pmic constraints
 quietly

---
 drivers/regulator/fwnode_regulator.c | 8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

diff --git a/drivers/regulator/fwnode_regulator.c b/drivers/regulator/fwnode_regulator.c
index 4df944c02b2a..48d151b07220 100644
--- a/drivers/regulator/fwnode_regulator.c
+++ b/drivers/regulator/fwnode_regulator.c
@@ -35,7 +35,7 @@ static void fwnode_get_regulator_prot_limits(struct fwnode_handle *np,
 				struct regulation_constraints *constraints)
 {
 	u32 pval;
-	int i, ret;
+	int i;
 	static const char *const props[] = {
 		"regulator-oc-%s-microamp",
 		"regulator-ov-%s-microvolt",
@@ -64,11 +64,9 @@ static void fwnode_get_regulator_prot_limits(struct fwnode_handle *np,
 
 		for (j = 0; j < ARRAY_SIZE(lvl); j++) {
 			snprintf(prop, 255, props[i], lvl[j]);
-			ret = fwnode_property_read_u32(np, prop, &pval);
-			if (!ret) {
+			found = !fwnode_property_read_u32(np, prop, &pval);
+			if (found)
 				fill_limit(l[j], pval);
-				found = true;
-			}
 			set[i] |= found;
 		}
 	}
