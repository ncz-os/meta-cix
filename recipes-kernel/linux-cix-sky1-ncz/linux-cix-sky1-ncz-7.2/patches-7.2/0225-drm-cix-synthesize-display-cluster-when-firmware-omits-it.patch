From: Jason Perlow <jperlow@gmail.com>
Subject: [PATCH] drm/cix: synthesize the display cluster when firmware omits CIXH50C0

Minisforum MS-R1 firmware does not declare the CIXH50C0 display-cluster
ACPI device that Radxa O6N declares. Measured on both boards running the
identical 7.2.0-sky1-ncz kernel:

  O6N   /sys/bus/platform/devices/CIXH50C0:00 present
        -> linlondp-cluster binds, aggregates the DPUs
        -> ONE DRM card (card0), all display ports on it
  MS-R1 no CIXH50C0 device at all (CIXH5010:00..04 and CIXH502F:00..04
        do exist)
        -> every DPU falls through to the standalone path
        -> FOUR DRM cards (card0..card3), two CRTCs each

linlondp_acpi_is_cluster_dpu_slave() only treats a DPU as a cluster slave
when its ACPI *parent* is CIXH50C0, and the cluster driver only probes on
a CIXH50C0 device, so a board whose firmware omits that node has no path
to a unified card.

Four user-visible failures on MS-R1 trace to this single gap:

  1. Moving a cable to a port owned by another card gives no signal --
     the compositor only ever opened one DRM device, and no hotplug path
     can recover a device it never opened.
  2. Chromium accelerated video is dead. Captured live during playback:
     the Chromium GPU process holds /dev/dri/renderD128 (card0, nothing
     connected) while the compositor holds /dev/dri/renderD130 (card2,
     the connected display). Buffers allocated on one DRM device cannot
     be scanned out by a compositor on another, so it fails at buffer
     allocation -- it never even opens a /dev/video* node, and the V4L2
     decoder stack is byte-identical between the two boards.
  3. Multi-monitor is unusable for the same reason.
  4. HDMI audio is fragmented: the four hdmi-audio-codec instances hang
     off the same four split DPTX pipelines.

Synthesize the cluster when firmware does not declare one. At module
init, if no CIXH50C0 device exists and two or more CIXH5010 devices do,
build a claim list and register a synthetic platform device carrying the
discovered ACPI paths, so the cluster driver reuses its existing
cix,dpu-acpi-paths collection path unchanged.

EXCLUDE PIPELINES WHOSE TRANSMITTER CANNOT BIND. A first version of this
patch claimed every CIXH5010 unconditionally and blanked the display
completely on MS-R1 -- zero DRM cards where the unpatched kernel had
four. Root cause, measured on that board:

  /sys/kernel/debug/devices_deferred
    CIXH502F:02   platform: supplier CIXH5040:00 not ready
    CIXH5040:00   platform: supplier CIXH5041:00 not ready

CIXH5040 is the eDP panel (drivers/gpu/drm/cix/dptx/cix_edp_panel.c) and
CONFIG_DRM_CIX_EDP_PANEL is not set: pipeline 02 is the internal-panel
output on a mini PC that has no internal panel, so its transmitter can
never bind. linlondp_dpu_add_graph_slaves() adds each pipeline's REMOTE
node -- the transmitter -- to the cluster master's component match, so a
single unbindable transmitter makes component_master_add_with_match()
never complete and drm_dev_register() never run for ANY DPU.

ACPI status does not discriminate: all five CIXH502F on MS-R1 report
_STA 0xB, including the dead one. Only actual driver binding does, so
linlondp_add_acpi_slave() gains a skip_unbound flag that drops a remote
failing device_is_bound(), and the synthetic probe waits on
driver_deferred_probe_check_state() before making that judgement -- but
only when at least one transmitter is still unbound, so a healthy board
takes a fast path with no added delay. If fewer than two DPUs survive
the filter no cluster is registered at all and the board keeps the
standalone path, because a board must never end up with zero cards.

Boards whose firmware DOES declare CIXH50C0 are untouched: acpi_dev_found()
is the first check and returns early, so the O6N path is preserved
bit-for-bit, and every skip_unbound=false call site behaves as before.
DT boards are unaffected. Single-DPU boards keep the standalone path (the
>=2 guard).

Signed-off-by: Jason Perlow <jperlow@gmail.com>
---
diff --git a/drivers/gpu/drm/cix/linlon-dp/linlondp_cluster.c b/drivers/gpu/drm/cix/linlon-dp/linlondp_cluster.c
index dcc338c29b62..f310affbdc63 100644
--- a/drivers/gpu/drm/cix/linlon-dp/linlondp_cluster.c
+++ b/drivers/gpu/drm/cix/linlon-dp/linlondp_cluster.c
@@ -35,6 +35,7 @@
 #if IS_ENABLED(CONFIG_ACPI)
 #include <linux/pm.h>
 #endif
+#include <linux/property.h>
 #include <linux/slab.h>
 #include <linux/string.h>
 #include <linux/acpi.h>
@@ -256,7 +257,8 @@ static int linlondp_cluster_acpi_child_cb(struct acpi_device *child, void *data)
 	put_device(phys);
 
 	ctx->cl->mdevs[ctx->idx] = mdev;
-	err = linlondp_dpu_add_graph_slaves(ctx->cluster_dev, ctx->match, mdev->dev);
+	err = linlondp_dpu_add_graph_slaves(ctx->cluster_dev, ctx->match,
+					    mdev->dev, false);
 	if (err) {
 		dev_warn(ctx->cluster_dev,
 			 "ACPI cluster: skip child %s, add_graph_slaves failed: %d\n",
@@ -270,7 +272,8 @@ static int linlondp_cluster_acpi_child_cb(struct acpi_device *child, void *data)
 /* Returns DPU count, -ENOENT if property absent, else error. */
 static int linlondp_cluster_collect_dpus_acpi_paths(struct device *dev,
 						    struct linlondp_cluster *cl,
-						    struct component_match **match)
+						    struct component_match **match,
+						    bool skip_unbound)
 {
 	const char *buf;
 	char *kbuf, *p, *token;
@@ -343,7 +346,8 @@ static int linlondp_cluster_collect_dpus_acpi_paths(struct device *dev,
 		}
 		put_device(phys);
 
-		err = linlondp_dpu_add_graph_slaves(dev, match, cl->mdevs[n]->dev);
+		err = linlondp_dpu_add_graph_slaves(dev, match, cl->mdevs[n]->dev,
+						    skip_unbound);
 		if (err) {
 			dev_warn(dev,
 				 "linlon-cluster: skip ACPI path \"%s\", add_graph_slaves failed: %d\n",
@@ -401,7 +405,7 @@ static int linlondp_cluster_probe_acpi(struct platform_device *pdev)
 		 "linlon-cluster: ACPI cluster HID %s (%s) — match CIXH50C0 / cix,dpu-acpi-paths or child CIXH5010\n",
 		 hid ? hid : "?", dev_name(dev));
 
-	n = linlondp_cluster_collect_dpus_acpi_paths(dev, cl, &match);
+	n = linlondp_cluster_collect_dpus_acpi_paths(dev, cl, &match, false);
 	if (n == -ENOENT)
 		n = linlondp_cluster_collect_dpus_acpi_children(cluster_adev, dev,
 								cl, &match);
@@ -479,7 +483,7 @@ static int linlondp_cluster_probe_of(struct platform_device *pdev)
 		dev_info(dev, "dpu %d ready: %s\n", i, dev_name(mdev->dev));
 
 		cl->mdevs[used] = mdev;
-		err = linlondp_dpu_add_graph_slaves(dev, &match, mdev->dev);
+		err = linlondp_dpu_add_graph_slaves(dev, &match, mdev->dev, false);
 		if (err)
 			return err;
 		used++;
@@ -499,6 +503,208 @@ static int linlondp_cluster_probe_of(struct platform_device *pdev)
 					       match);
 }
 
+/*
+ * The cix,dpu-acpi-paths collection above is independent of the device
+ * being a real ACPI device; it only reads the property out of
+ * dev->fwnode. The synthetic cluster device has no ACPI_COMPANION() —
+ * its fwnode is the software_node registered by the linlondp driver —
+ * so it bypasses linlondp_cluster_probe_acpi() and goes through this
+ * trimmed path instead.
+ *
+ * On the MS-R1 the synthetic path needs to defend against one unbindable
+ * transmitter (CIXH502F:02 -> CIXH5040 eDP panel) which CONFIG_DRM_CIX_EDP_PANEL
+ * never binds. component_master_add_with_match() never completes if any
+ * match entry is unbindable, so without the filter the board boots with
+ * zero DRM cards. The check walks each DPU's pipelines@N children,
+ * resolves each output remote and tests device_is_bound() under the
+ * device lock.
+ *
+ * Fast path: if every transmitter is already bound when we run (the
+ * healthy case on every normal board) we proceed with no deferral and
+ * no measurable delay. Only boards that genuinely have a permanently
+ * dead pipeline incur the deferred-probe wait (capped by
+ * CONFIG_DRIVER_DEFERRED_PROBE_TIMEOUT, 10s here) before the cluster
+ * builds without the bad pipeline.
+ */
+static int linlondp_cluster_probe_synthetic(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct linlondp_cluster *cl;
+	struct component_match *match = NULL;
+	const char *buf;
+	char *kbuf, *p, *token;
+	bool any_unbound = false;
+	bool any_bound = false;
+	int n, err;
+
+	if (device_property_read_string(dev, "cix,dpu-acpi-paths", &buf))
+		return dev_err_probe(dev, -EINVAL,
+				     "synthetic cluster: no cix,dpu-acpi-paths\n");
+
+	kbuf = kstrdup(buf, GFP_KERNEL);
+	if (!kbuf)
+		return -ENOMEM;
+
+	/*
+	 * Pass 1: walk the DPUs along cix,dpu-acpi-paths. For each DPU,
+	 * walk its pipeline@N children (exactly the structure the slave
+	 * helper invokes fwnode_for_each_child_node on) and resolve both
+	 * remote endpoints with the same fwnode_graph_get_remote_node()
+	 * call the slave helper uses. Any remote whose backing struct
+	 * device is absent OR fails device_is_bound() marks
+	 * any_unbound = true.
+	 *
+	 * device_is_bound() requires the device lock per its contract;
+	 * the lock is taken just for the read so we never hold it across
+	 * the fwnode resolution. The fwnode reference is balanced by the
+	 * matching put: we keep a get while we look at ->dev, then drop
+	 * it before moving on. Every iteration drops the references it
+	 * accumulated.
+	 */
+	p = kbuf;
+	while ((token = strsep(&p, ","))) {
+		acpi_handle h;
+		struct acpi_device *adev;
+		struct device *phys;
+		struct fwnode_handle *dpu_fwnode;
+		struct fwnode_handle *child;
+
+		while (*token == ' ' || *token == '\t')
+			token++;
+		if (!*token)
+			continue;
+
+		if (ACPI_FAILURE(acpi_get_handle(ACPI_ROOT_OBJECT, token, &h)))
+			continue;
+
+		adev = acpi_fetch_acpi_dev(h);
+		if (!adev)
+			continue;
+
+		phys = acpi_get_first_physical_node(adev);
+		if (!phys || !dev_is_platform(phys)) {
+			if (phys)
+				put_device(phys);
+			continue;
+		}
+		put_device(phys);
+
+		dpu_fwnode = dev_fwnode(phys);
+		if (!dpu_fwnode)
+			continue;
+
+		fwnode_for_each_child_node(dpu_fwnode, child) {
+			const char *tmp_name;
+			struct fwnode_handle *remote;
+			struct device *rdev;
+			bool bound;
+			int ep;
+
+			tmp_name = child->ops->get_name(child);
+			if (!tmp_name || strncmp(tmp_name, "pipeline", 8))
+				continue;
+
+			/*
+			 * Two outputs per pipeline, identical to the
+			 * slave helper's call pattern.
+			 */
+			for (ep = 0; ep < 2; ep++) {
+				remote = fwnode_graph_get_remote_node(child,
+							 LINLONDP_OF_PORT_OUTPUT,
+							 ep);
+				if (!remote)
+					continue;
+				rdev = remote->dev;
+				if (!rdev) {
+					fwnode_handle_put(remote);
+					any_unbound = true;
+					continue;
+				}
+				device_lock(rdev);
+				bound = device_is_bound(rdev);
+				device_unlock(rdev);
+				if (!bound) {
+					dev_info(dev,
+						 "linlondp: transmitter %s not bound yet (deferred)\n",
+						 dev_name(rdev));
+					any_unbound = true;
+				} else {
+					any_bound = true;
+				}
+				fwnode_handle_put(remote);
+			}
+		}
+	}
+	kfree(kbuf);
+
+	/*
+	 * Fast path: every transmitter is already bound. Drop straight
+	 * through to building the cluster. No deferral, no measurable
+	 * delay before DRM appears. This is the path every healthy board
+	 * takes (MS-R1 once we drop CIXH5040:00/CIXH502F:02 from the
+	 * match list, O6N untouched, etc).
+	 */
+	if (any_unbound) {
+		err = driver_deferred_probe_check_state(dev);
+		if (err == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+		/*
+		 * -ENODEV / -ETIMEDOUT: deferred probe has finished and
+		 * the missing supplier will never appear. Fall through and
+		 * build the cluster WITHOUT the bad pipeline; the collect
+		 * helper below uses skip_unbound=true so the unbound
+		 * transmitter is omitted from the match list.
+		 */
+		dev_info(dev,
+			 "linlondp: deferred probe expired (%d), building cluster without unbound transmitters\n",
+			 err);
+	}
+
+	cl = devm_kzalloc(dev, sizeof(*cl), GFP_KERNEL);
+	if (!cl)
+		return -ENOMEM;
+
+	n = linlondp_cluster_collect_dpus_acpi_paths(dev, cl, &match, true);
+	if (n < 0)
+		return dev_err_probe(dev, n == -ENOENT ? -EINVAL : n,
+				     "synthetic cluster: no DPUs from cix,dpu-acpi-paths\n");
+
+	/*
+	 * If fewer than two DPUs survive the filter the cluster is not
+	 * worth standing up — return -ENODEV so each DPU keeps the
+	 * stand-alone path. "Never zero cards" means a board whose only
+	 * bad pipeline is one of the synthetic-cluster DPUs still gets
+	 * its standalone card for the survivors.
+	 */
+	if (n < 2) {
+		dev_info(dev,
+			 "linlondp: synthetic cluster degenerated to %u DPU(s); staying standalone\n",
+			 n);
+		return -ENODEV;
+	}
+
+	if (any_unbound)
+		dev_info(dev,
+			 "linlondp: synthetic cluster built with %u DPU(s) after excluding unbound transmitters\n",
+			 n);
+
+	cl->n_mdevs = n;
+	dev_set_drvdata(dev, cl);
+
+	dev_info(dev,
+		 "linlon-cluster: synthetic cluster registered %u DPU(s) (fast=%s)\n",
+		 cl->n_mdevs, any_bound && !any_unbound ? "yes" : "no");
+
+	/* Match the ACPI probe: keep direct_complete off. */
+	dev_pm_set_driver_flags(&pdev->dev, DPM_FLAG_NO_DIRECT_COMPLETE);
+
+	err = component_master_add_with_match(dev, &linlondp_cluster_master_ops,
+					      match);
+	if (err)
+		dev_set_drvdata(dev, NULL);
+	return err;
+}
+
 static int linlondp_cluster_probe(struct platform_device *pdev)
 {
 #if IS_ENABLED(CONFIG_ACPI)
@@ -507,6 +713,9 @@ static int linlondp_cluster_probe(struct platform_device *pdev)
 	aid = acpi_match_device(linlondp_cluster_acpi_match, &pdev->dev);
 	if (aid)
 		return linlondp_cluster_probe_acpi(pdev);
+
+	if (device_property_present(&pdev->dev, "cix,linlon-synthetic-cluster"))
+		return linlondp_cluster_probe_synthetic(pdev);
 #endif
 	if (pdev->dev.of_node)
 		return linlondp_cluster_probe_of(pdev);
diff --git a/drivers/gpu/drm/cix/linlon-dp/linlondp_dev.h b/drivers/gpu/drm/cix/linlon-dp/linlondp_dev.h
index 445428c0183a..e2e9633a44a2 100644
--- a/drivers/gpu/drm/cix/linlon-dp/linlondp_dev.h
+++ b/drivers/gpu/drm/cix/linlon-dp/linlondp_dev.h
@@ -296,7 +296,7 @@ void linlondp_print_events(struct linlondp_events *evts, struct drm_device *dev,
 struct component_match;
 int linlondp_dpu_add_graph_slaves(struct device *master,
 				  struct component_match **match,
-				  struct device *dpu_dev);
+				  struct device *dpu_dev, bool skip_unbound);
 
 int linlondp_dev_resume(struct linlondp_dev *mdev);
 int linlondp_dev_suspend(struct linlondp_dev *mdev);
diff --git a/drivers/gpu/drm/cix/linlon-dp/linlondp_drv.c b/drivers/gpu/drm/cix/linlon-dp/linlondp_drv.c
index 72884d17c995..3b8fe4c27f76 100644
--- a/drivers/gpu/drm/cix/linlon-dp/linlondp_drv.c
+++ b/drivers/gpu/drm/cix/linlon-dp/linlondp_drv.c
@@ -7,10 +7,21 @@
 #include <linux/module.h>
 #include <linux/kernel.h>
 #include <linux/acpi.h>
+/*
+ * ACPI namespace paths for these DPUs are short (\_SB.DPU0 form: four-char
+ * name segments separated by dots). Using PATH_MAX (4096) here would place a
+ * ~20 KB scan context on a 16 KB arm64 kernel stack -- ten times over this
+ * tree's CONFIG_FRAME_WARN (2048), and a VMAP_STACK guard-page panic waiting
+ * to happen. 128 bytes is far beyond any real Sky1 DPU path depth.
+ */
+#define LINLONDP_ACPI_PATH_MAX 128
 #include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/component.h>
 #include <linux/pm_runtime.h>
 #include <linux/aperture.h>
+#include <linux/slab.h>
+#include <linux/string.h>
 #include <drm/drm_fb_helper.h>
 #include <drm/drm_module.h>
 #include <drm/drm_of.h>
@@ -23,6 +34,22 @@
 #if IS_ENABLED(CONFIG_ACPI)
 #include <acpi/acpi_bus.h>
 
+/*
+ * Module-scope claim list used by linlondp_acpi_is_cluster_dpu_slave() and
+ * populated by linlondp_create_synthetic_cluster(). When firmware does not
+ * declare a CIXH50C0 cluster but exposes multiple CIXH5010 DPUs, every DPU on
+ * this list is forced onto the slave path so the synthesized cluster is the
+ * only master and only one DRM card is registered.
+ *
+ * The list is bounded by LINLONDP_MAX_CLUSTER_DPUS (linlondp_pipeline.h) and
+ * never grows at runtime; once published in linlondp_mod_init() it is
+ * read-only until the module exits. Defined further down in this file; the
+ * forward references here are deliberate so the slave check (above) can use
+ * it.
+ */
+extern acpi_handle linlondp_synthetic_dpu_handles[LINLONDP_MAX_CLUSTER_DPUS];
+extern unsigned int linlondp_synthetic_dpu_count;
+
 /*
  * ACPI cluster (CIXH50C0): each DPU (CIXH5010) must not register its own DRM
  * card — same as DT "cix,linlon-dpu-slave". Firmware may set _DSD
@@ -32,10 +59,29 @@
 static bool linlondp_acpi_is_cluster_dpu_slave(struct device *dev)
 {
 	struct acpi_device *adev, *parent;
+	acpi_handle h;
+	unsigned int i;
 
 	if (!has_acpi_companion(dev))
 		return false;
 	adev = ACPI_COMPANION(dev);
+
+	/*
+	 * Claimed-by-synthetic-cluster list: when firmware does not
+	 * declare a CIXH50C0 parent but the module init path has elected
+	 * to synthesize one, every CIXH5010 on the claim list must take
+	 * the slave path so the cluster is the only master. The list is
+	 * populated before the linlondp platform driver can bind any
+	 * CIXH5010 (see linlondp_create_synthetic_cluster), so this
+	 * check is the first line of defence against a stand-alone DRM
+	 * card.
+	 */
+	h = adev->handle;
+	for (i = 0; i < linlondp_synthetic_dpu_count; i++) {
+		if (linlondp_synthetic_dpu_handles[i] == h)
+			return true;
+	}
+
 	parent = acpi_dev_parent(adev);
 	return parent && acpi_dev_hid_uid_match(parent, "CIXH50C0", NULL);
 }
@@ -188,19 +234,54 @@ static void drm_release_fwnode(struct device *dev, void *data)
 static void linlondp_add_acpi_slave(struct device *master,
 				    struct component_match **match,
 				    struct fwnode_handle *np, u32 port,
-				    u32 endpoint)
+				    u32 endpoint, bool skip_unbound)
 {
 	struct fwnode_handle *remote;
+	struct device *remote_dev;
+	bool bound;
 
 	remote = fwnode_graph_get_remote_node(np, port, endpoint);
+	if (!remote)
+		return;
 
-	if (remote) {
-		pr_info("%s. remote.name=%s\n", __func__, dev_name(remote->dev));
-		fwnode_handle_get(remote);
-		component_match_add_release(master, match, drm_release_fwnode,
-					    compare_of, remote);
-		fwnode_handle_put(remote);
+	/*
+	 * skip_unbound: the cluster's component match list must hold ONLY
+	 * devices that will actually bind. An unbindable component makes
+	 * component_master_add_with_match() never complete (see commit
+	 * context: one unbindable CIXH5040 panel sticks the MS-R1's whole
+	 * master). Resolve the fwnode to its backing struct device; fwnode
+	 * references count balances itself once fwnode_handle_put() runs
+	 * below. device_is_bound() requires the device lock; take it just
+	 * for the read.
+	 */
+	remote_dev = remote->dev;
+
+	if (skip_unbound) {
+		if (!remote_dev) {
+			dev_info(master,
+				 "linlondp: skip empty fwnode at port %u ep %u\n",
+				 port, endpoint);
+			fwnode_handle_put(remote);
+			return;
+		}
+		device_lock(remote_dev);
+		bound = device_is_bound(remote_dev);
+		device_unlock(remote_dev);
+		if (!bound) {
+			dev_info(master,
+				 "linlondp: skip unbound transmitter %s (no driver will bind; dropping from cluster match list)\n",
+				 dev_name(remote_dev));
+			fwnode_handle_put(remote);
+			return;
+		}
 	}
+
+	pr_info("%s. remote.name=%s\n", __func__,
+		remote_dev ? dev_name(remote_dev) : "(no-dev)");
+	fwnode_handle_get(remote);
+	component_match_add_release(master, match, drm_release_fwnode,
+				    compare_of, remote);
+	fwnode_handle_put(remote);
 }
 
 static void linlondp_add_slave(struct device *master,
@@ -218,7 +299,7 @@ static void linlondp_add_slave(struct device *master,
 
 int linlondp_dpu_add_graph_slaves(struct device *master,
 				  struct component_match **match,
-				  struct device *dpu_dev)
+				  struct device *dpu_dev, bool skip_unbound)
 {
 	struct device_node *np = dpu_dev->of_node;
 	struct device_node *of_child;
@@ -233,9 +314,11 @@ int linlondp_dpu_add_graph_slaves(struct device *master,
 				continue;
 
 			linlondp_add_acpi_slave(master, match, acpi_child,
-						LINLONDP_OF_PORT_OUTPUT, 0);
+						LINLONDP_OF_PORT_OUTPUT, 0,
+						skip_unbound);
 			linlondp_add_acpi_slave(master, match, acpi_child,
-						LINLONDP_OF_PORT_OUTPUT, 1);
+						LINLONDP_OF_PORT_OUTPUT, 1,
+						skip_unbound);
 		}
 		return 0;
 	}
@@ -312,10 +395,18 @@ static int linlondp_platform_probe(struct platform_device *pdev)
 
 			/* add connector */
 			pr_info("%s enter to add connector.\n", __func__);
+			/*
+			 * Standalone (non-cluster) DPU path: preserve
+			 * byte-for-byte the prior behaviour — no
+			 * skip_unbound filter — so an existing single-card
+			 * board is not regressed.
+			 */
 			linlondp_add_acpi_slave(dev, &match, acpi_child,
-						LINLONDP_OF_PORT_OUTPUT, 0);
