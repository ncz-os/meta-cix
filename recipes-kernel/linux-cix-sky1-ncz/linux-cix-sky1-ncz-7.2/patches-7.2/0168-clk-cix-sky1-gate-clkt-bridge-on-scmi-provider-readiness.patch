From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Mon, 21 Jul 2026 04:40:00 +0800
Subject: [PATCH] clk: cix: sky1: gate CLKT bridge on SCMI clock provider
 readiness

The ACPI CLKT->clkdev bridge (sky1_acpi_clk_probe) walks the ACPI
namespace once, calls clk_get(NULL, "scmi-clk-<id>") for each CLKT
entry, and creates a clkdev alias for the ones that resolve. It then
returns success as soon as any entry mapped (priv->mapped > 0; see
0157). On CIX Sky1 there are multiple SCMI clock provider instances
that bind at different times: on Orion O6N the SCMI clock device
(protocol 0x14, name "clocks") is created ~0.3s AFTER this bridge
probes, so the bridge maps only the clocks the early providers have
published, returns success, and never re-runs. The late providers
clocks (sof_clk, fch_timer_apb, the usb-dp/usb3 phy apb clocks) are
therefore never aliased, and their consumers (cdnsp-sky1, cdns-i2c,
sky1_timer, cix-usbdp-phy, cix-usb3-phy) spin in deferred-probe
forever waiting on a clkdev alias that will never appear. O6N hangs
pre-network. The same kernel on the MS-R1 reference board works only
because there the providers happen to bind before the bridge probes.

Reverting to "defer the whole probe until every CLKT entry maps"
(0148) is not an option: on boards where some CLKT entries reference
genuinely-absent SCMI clocks, priv->pending never reaches 0, and each
-EPROBE_DEFER return runs devres_release_all() and re-walks from
zero, producing an unbounded synchronized consumer retry storm that
never converges.

Fix the ordering directly: before walking, require that every SCMI
clock provider this bridge depends on is already bound. Enumerate the
SCMI controllers by their ACPI HID (CIXHA006), confirm each has a
bound arm-scmi core, and confirm the SCMI clock device
(protocol_id == SCMI_PROTOCOL_CLOCK, name "clocks") on scmi_bus_type
is bound. If any is missing or unbound, return -EPROBE_DEFER on that
single bounded condition (not per-clock). Once all providers are
bound, every scmi-clk-<id> alias they own is registered, so the
existing single walk maps every CLKT entry that has a real clock and
harmlessly skips any genuinely-absent one - converging on O6N without
the 0148 storm and without regressing the reference board.

Upstream-Status: Pending
Signed-off-by: Jason Perlow <jperlow@gmail.com>
---
diff --git a/drivers/clk/cix/clk-sky1-acpi.c b/drivers/clk/cix/clk-sky1-acpi.c
index 6cc3108..6b05347 100644
--- a/drivers/clk/cix/clk-sky1-acpi.c
+++ b/drivers/clk/cix/clk-sky1-acpi.c
@@ -20,8 +20,20 @@
 #include <linux/acpi.h>
 #include <linux/clk.h>
 #include <linux/clkdev.h>
+#include <linux/device.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/scmi_protocol.h>
+#include <linux/string.h>
+
+#define SKY1_SCMI_ACPI_HID	"CIXHA006"
+#define SKY1_SCMI_CORE_PREFIX	"arm-scmi."
+
+/* scmi_bus_type is exported (EXPORT_SYMBOL_GPL) but only declared in the
+ * private drivers/firmware/arm_scmi/common.h; declare it locally so this
+ * out-of-subsystem bridge can enumerate SCMI devices to gate on provider
+ * readiness. */
+extern const struct bus_type scmi_bus_type;
 
 struct sky1_acpi_clk {
 	struct device *dev;
@@ -30,6 +42,124 @@ struct sky1_acpi_clk {
 	int error;
 };
 
+struct sky1_scmi_ready {
+	struct device *dev;
+	int acpi_controllers;
+	int scmi_cores;
+	int unbound_scmi_cores;
+	int clock_devices;
+	int unbound_clock_devices;
+};
+
+struct sky1_scmi_acpi_ctx {
+	struct sky1_scmi_ready *ready;
+	struct acpi_device *adev;
+	bool found_core;
+};
+
+static int sky1_scmi_core_child_cb(struct device *dev, void *data)
+{
+	struct sky1_scmi_acpi_ctx *ctx = data;
+
+	if (!str_has_prefix(dev_name(dev), SKY1_SCMI_CORE_PREFIX))
+		return 0;
+
+	ctx->found_core = true;
+	ctx->ready->scmi_cores++;
+
+	if (!device_is_bound(dev)) {
+		dev_dbg(ctx->ready->dev,
+			"SCMI core %s for %s is not bound yet\n",
+			dev_name(dev), acpi_dev_name(ctx->adev));
+		ctx->ready->unbound_scmi_cores++;
+	}
+
+	return 0;
+}
+
+static acpi_status sky1_scmi_acpi_cb(acpi_handle handle, u32 level,
+				     void *context, void **ret_val)
+{
+	struct sky1_scmi_ready *ready = context;
+	struct sky1_scmi_acpi_ctx ctx = {
+		.ready = ready,
+	};
+	struct device *phys;
+
+	ctx.adev = acpi_fetch_acpi_dev(handle);
+	if (!ctx.adev)
+		return AE_OK;
+
+	ready->acpi_controllers++;
+
+	phys = acpi_get_first_physical_node(ctx.adev);
+	if (!phys) {
+		dev_dbg(ready->dev,
+			"SCMI ACPI device %s has no physical device yet\n",
+			acpi_dev_name(ctx.adev));
+		ready->unbound_scmi_cores++;
+		return AE_OK;
+	}
+
+	device_for_each_child(phys, &ctx, sky1_scmi_core_child_cb);
+	if (!ctx.found_core) {
+		dev_dbg(ready->dev,
+			"SCMI ACPI device %s has no arm-scmi core yet\n",
+			acpi_dev_name(ctx.adev));
+		ready->unbound_scmi_cores++;
+	}
+
+	return AE_OK;
+}
+
+static int sky1_scmi_clock_device_cb(struct device *dev, void *data)
+{
+	struct sky1_scmi_ready *ready = data;
+	struct scmi_device *sdev = to_scmi_dev(dev);
+
+	if (sdev->protocol_id != SCMI_PROTOCOL_CLOCK ||
+	    strcmp(sdev->name, "clocks"))
+		return 0;
+
+	ready->clock_devices++;
+
+	if (!device_is_bound(dev)) {
+		dev_dbg(ready->dev, "SCMI clock provider %s is not bound yet\n",
+			dev_name(dev));
+		ready->unbound_clock_devices++;
+	}
+
+	return 0;
+}
+
+static int sky1_scmi_clock_providers_ready(struct device *dev)
+{
+	struct sky1_scmi_ready ready = {
+		.dev = dev,
+	};
+	acpi_status status;
+
+	status = acpi_get_devices(SKY1_SCMI_ACPI_HID, sky1_scmi_acpi_cb,
+				  &ready, NULL);
+	if (ACPI_FAILURE(status))
+		return -ENODEV;
+
+	bus_for_each_dev(&scmi_bus_type, NULL, &ready,
+			 sky1_scmi_clock_device_cb);
+
+	if (!ready.acpi_controllers || !ready.scmi_cores ||
+	    ready.unbound_scmi_cores || !ready.clock_devices ||
+	    ready.unbound_clock_devices)
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "SCMI clock providers not ready: acpi=%d cores=%d unbound_cores=%d clocks=%d unbound_clocks=%d\n",
+				     ready.acpi_controllers, ready.scmi_cores,
+				     ready.unbound_scmi_cores,
+				     ready.clock_devices,
+				     ready.unbound_clock_devices);
+
+	return 0;
+}
+
 static void sky1_clkdev_drop(void *data)
 {
 	clkdev_drop(data);
@@ -160,8 +290,13 @@ out:
 static int sky1_acpi_clk_probe(struct platform_device *pdev)
 {
 	struct sky1_acpi_clk *priv;
+	int ret;
 	acpi_status status;
 
+	ret = sky1_scmi_clock_providers_ready(&pdev->dev);
+	if (ret)
+		return ret;
+
 	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
 	if (!priv)
 		return -ENOMEM;
-- 
2.51.0
