From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Thu, 23 Jul 2026 00:00:00 -0400
Subject: [PATCH 175/175] drm/panthor: sky1 direct-SMC GPU power-on when SCMI is
 off (acpi_scmi_en=off)

NCZ-OS boots the CIX Sky1 (Mali-G720) 7.2 kernel with acpi_scmi_en=off,
which is required so the ACPI SCMI mailbox does not clash with PCIe/NVMe
power management. Disabling SCMI also removes the ACPI SCMI power-domain
(genpd) provider, so nothing attaches or powers the GPU power domain.

Under DT, the GPU domain is powered by the "smc_devpd" node (arm,scmi-smc
transport): it issues an SCMI POWER_STATE_SET to Trusted Firmware-A (TF-A)
via SMC function 0xc2000001, using the SCMI shared-memory mailbox at
0x84380000. TF-A powers domain 21 (the GPU) AND programs the IDM
(Interconnect Domain Manager) to grant non-secure (Linux) access to the
GPU register block. Without that un-secure step, panthor's first GPU MMIO
access faults the secure world and the console floods with
"IDM: GPU secure access, error status=0x0 addr=0x0", hanging the boot.

The proprietary mali_kbase DKMS driver works under acpi_scmi_en=off
because it reaches the GPU domain through the same TF-A SCMI-over-SMC
server rather than Linux's SCMI genpd. This patch gives panthor the same
fallback: replicate the smc_devpd POWER_STATE_SET sequence with a direct
arm_smccc_smc() call in panthor_pm_domain_init(), before any GPU MMIO.

The fallback is tightly guarded so the normal genpd path is untouched
when SCMI is available: it only runs when
  (a) the device is CIX Sky1 (panthor_is_sky1()), AND
  (b) the device was enumerated via ACPI (has_acpi_companion()), AND
  (c) no power domain is attached (dev->pm_domain == NULL) -- i.e. the
      ACPI SCMI genpd is genuinely absent because SCMI is disabled.
When SCMI is enabled the ACPI bus attaches the genpd (dev->pm_domain is
set) and this block is skipped, leaving the genpd power path in charge.
It talks to the TF-A SCMI server directly (which exists whether or not
Linux's SCMI driver bound), so there is no contention with a live SCMI
channel: when SCMI is on we never enter this path.

This is a re-port of the raw-SMC fallback that existed in the 7.1.1 CIX
ACPI patch (0011-drm-panthor-add-acpi-support-for-cix-p1) and was
deliberately dropped from the 7.2 forward-port (0084) on the assumption
that dev_pm_domain_attach_list() would always find the domain -- an
assumption that does not hold when acpi_scmi_en=off.

Signed-off-by: Jason Perlow <jperlow@gmail.com>

Upstream-Status: Inappropriate [oe-specific]
---
 drivers/gpu/drm/panthor/panthor_device.c | 132 ++++++++++++++++++++++
 1 file changed, 132 insertions(+)

--- a/drivers/gpu/drm/panthor/panthor_device.c
+++ b/drivers/gpu/drm/panthor/panthor_device.c
@@ -5,7 +5,11 @@
 /* Copyright 2025 ARM Limited. All rights reserved. */
 
 #include <linux/acpi.h>
+#include <linux/arm-smccc.h>
+#include <linux/bits.h>
 #include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/io.h>
 #include <linux/mm.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -97,6 +101,119 @@
 		return true;
 
 	return false;
+}
+
+/*
+ * CIX Sky1 GPU power-on via a raw SMC to Trusted Firmware-A (TF-A),
+ * bypassing Linux's SCMI stack entirely.
+ *
+ * Under DT, the "smc_devpd" node (arm,scmi-smc transport) is what powers
+ * the GPU domain: it sends an SCMI POWER_STATE_SET to TF-A via SMC
+ * function 0xc2000001, using the SCMI shared-memory mailbox at
+ * 0x84380000. TF-A not only powers domain 21 (the GPU) but also programs
+ * the IDM (Interconnect Domain Manager) to grant non-secure (Linux)
+ * access to the GPU register block. Without that step, the very first
+ * GPU MMIO access faults the secure world and floods the console with
+ * "IDM: GPU secure access" errors (an unrecoverable SError on some revs).
+ *
+ * On NCZ-OS the kernel boots with acpi_scmi_en=off (required so the
+ * ACPI SCMI mailbox does not clash with PCIe/NVMe power management).
+ * With SCMI disabled there is no smc_devpd and no ACPI SCMI genpd, so
+ * nothing performs the power-on / un-secure and panthor hangs. We
+ * replicate the smc_devpd sequence directly here.
+ *
+ * This talks to the TF-A SCMI *server* over SMC, which exists whether or
+ * not Linux's own SCMI driver is bound, so it is safe under
+ * acpi_scmi_en=off. It is only invoked when no genpd is attached (i.e.
+ * SCMI is genuinely absent) so the normal genpd power path is untouched
+ * when SCMI is enabled.
+ */
+#define SKY1_SMC_SCMI_FUNC_ID		0xc2000001
+#define SKY1_SMC_SCMI_SHMEM_PHYS	0x84380000UL
+#define SKY1_SMC_SCMI_SHMEM_SIZE	0x80
+#define SKY1_PD_GPU			21
+
+/* SCMI shared-memory layout (arm,scmi-shmem) */
+#define SCMI_SHMEM_CHAN_STATUS		0x04
+#define SCMI_SHMEM_FLAGS		0x10
+#define SCMI_SHMEM_LENGTH		0x14
+#define SCMI_SHMEM_MSG_HEADER		0x18
+#define SCMI_SHMEM_MSG_PAYLOAD		0x1c
+
+static int sky1_smc_scmi_power_set(struct device *dev, u32 domain, u32 state)
+{
+	void __iomem *shmem;
+	struct arm_smccc_res res;
+	u32 msg_header, resp_status;
+	int timeout = 1000;
+
+	shmem = ioremap(SKY1_SMC_SCMI_SHMEM_PHYS, SKY1_SMC_SCMI_SHMEM_SIZE);
+	if (!shmem)
+		return -ENOMEM;
+
+	/* Wait for the channel to be free (BIT(0) of CHAN_STATUS set). */
+	while (!(ioread32(shmem + SCMI_SHMEM_CHAN_STATUS) & BIT(0))) {
+		if (--timeout <= 0) {
+			dev_err(dev, "SCMI SMC channel busy timeout\n");
+			iounmap(shmem);
+			return -ETIMEDOUT;
+		}
+		udelay(10);
+	}
+
+	/* Claim the channel (clear free bit) and select polling mode. */
+	iowrite32(0, shmem + SCMI_SHMEM_CHAN_STATUS);
+	iowrite32(0, shmem + SCMI_SHMEM_FLAGS);
+
+	/*
+	 * Message header:
+	 *   bits  0-7 : MSG_ID      = 0x04 (POWER_STATE_SET)
+	 *   bits  8-9 : MSG_TYPE    = 0    (command)
+	 *   bits 10-17: PROTOCOL_ID = 0x11 (POWER)
+	 *   bits 18-27: TOKEN       = 0
+	 */
+	msg_header = 0x04 | (0x11 << 10);
+	iowrite32(msg_header, shmem + SCMI_SHMEM_MSG_HEADER);
+
+	/* Payload: flags(4) + domain_id(4) + power_state(4) = 12 bytes. */
+	iowrite32(0, shmem + SCMI_SHMEM_MSG_PAYLOAD);		/* flags: sync */
+	iowrite32(domain, shmem + SCMI_SHMEM_MSG_PAYLOAD + 4);
+	iowrite32(state, shmem + SCMI_SHMEM_MSG_PAYLOAD + 8);
+
+	/* Length = msg_header(4) + payload(12) = 16 bytes. */
+	iowrite32(16, shmem + SCMI_SHMEM_LENGTH);
+
+	/*
+	 * Ensure all mailbox writes above land before the SMC doorbell.
+	 * arm64 orders writes to Device memory, but make the firmware-ABI
+	 * ordering intent explicit and mapping-assumption-proof.
+	 */
+	wmb();
+
+	/* Doorbell: arg1 = shmem page, arg2 = offset within page. */
+	arm_smccc_smc(SKY1_SMC_SCMI_FUNC_ID,
+		      SKY1_SMC_SCMI_SHMEM_PHYS >> 12,
+		      SKY1_SMC_SCMI_SHMEM_PHYS & 0xFFF,
+		      0, 0, 0, 0, 0, &res);
+
+	if (res.a0) {
+		dev_err(dev, "SCMI SMC returned error: 0x%lx\n", res.a0);
+		iounmap(shmem);
+		return -EIO;
+	}
+
+	/* Response: first payload word is the SCMI status. */
+	resp_status = ioread32(shmem + SCMI_SHMEM_MSG_PAYLOAD);
+	iounmap(shmem);
+
+	if (resp_status != 0) {
+		dev_err(dev, "SCMI POWER_STATE_SET domain %u failed: %d\n",
+			domain, resp_status);
+		return -EIO;
+	}
+
+	dev_info(dev, "GPU power domain %u powered on via SMC SCMI\n", domain);
+	return 0;
 }
 
 /*
@@ -113,6 +230,21 @@
 	struct device *dev = ptdev->base.dev;
 	int num_domains, i, err;
 
+	/*
+	 * CIX Sky1 under ACPI with SCMI disabled (acpi_scmi_en=off): no ACPI
+	 * SCMI genpd is registered, so the platform bus attaches no power
+	 * domain (dev->pm_domain == NULL) and nothing un-secures the GPU.
+	 * Do the raw-SMC power-on that smc_devpd performs under DT, before
+	 * any GPU MMIO. When a genpd IS attached (SCMI enabled) we skip this
+	 * and leave the normal genpd path in charge.
+	 */
+	if (panthor_is_sky1(ptdev) && has_acpi_companion(dev) &&
+	    !dev->pm_domain) {
+		err = sky1_smc_scmi_power_set(dev, SKY1_PD_GPU, 0);
+		if (err)
+			return err;
+	}
+
 	if (!IS_ENABLED(CONFIG_OF) || !dev->of_node)
 		return 0;
 
-- 
2.43.0
