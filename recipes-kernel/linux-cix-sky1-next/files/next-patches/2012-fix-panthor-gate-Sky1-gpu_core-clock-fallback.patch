From b47201132d264068d3cf5a90b247f2afdd4767c3 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Thu, 11 Jun 2026 00:17:01 -0400
Subject: [PATCH] fix(panthor): gate Sky1 gpu_core clock fallback to ACPI CIX
 GPU

---
 drivers/gpu/drm/panthor/panthor_device.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/gpu/drm/panthor/panthor_device.c b/drivers/gpu/drm/panthor/panthor_device.c
index ac89a4a20..535f2aac6 100644
--- a/drivers/gpu/drm/panthor/panthor_device.c
+++ b/drivers/gpu/drm/panthor/panthor_device.c
@@ -3,6 +3,7 @@
 /* Copyright 2019 Linaro, Ltd, Rob Herring <robh@kernel.org> */
 /* Copyright 2023 Collabora ltd. */
 
+#include <linux/acpi.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/iommu.h>
@@ -182,6 +183,13 @@ static int panthor_clk_init(struct panthor_device *ptdev)
 		return dev_err_probe(ptdev->base.dev,
 				     PTR_ERR(ptdev->clks.core),
 				     "get 'gpu_clk_core' clock failed");
+	if (!ptdev->clks.core && has_acpi_companion(ptdev->base.dev) &&
+	    acpi_dev_hid_match(ACPI_COMPANION(ptdev->base.dev), "CIXH5000"))
+		ptdev->clks.core = devm_clk_get_optional(ptdev->base.dev, "gpu_core");
+	if (IS_ERR(ptdev->clks.core))
+		return dev_err_probe(ptdev->base.dev,
+				     PTR_ERR(ptdev->clks.core),
+				     "get gpu_core clock failed");
 	if (!ptdev->clks.core) {
 		ptdev->clks.core = devm_clk_get(ptdev->base.dev, NULL);
 		if (IS_ERR(ptdev->clks.core))
-- 
2.51.0

