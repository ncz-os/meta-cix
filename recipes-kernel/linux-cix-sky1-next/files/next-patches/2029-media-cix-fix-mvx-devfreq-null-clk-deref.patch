From: Jason Perlow <jperlow@gmail.com>
Date: Tue, 28 Jul 2026 00:00:00 +0000
Subject: [PATCH] media: cix: fix mvx_devfreq_target NULL clk deref on 7.0.12

The devfreq_monitor workqueue's periodic target callback
(mvx_devfreq_target) calls dev_pm_opp_set_rate(dev, *freq), which
resolves to clk_round_rate() on a struct clk pointer that isn't
guaranteed to be prepared/valid at every point in this workqueue's
lifetime -- confirmed on real O6N hardware (serial-captured
2026-07-28): a NULL pointer dereference inside clk_round_rate(),
called via dev_pm_opp_set_rate() -> mvx_devfreq_target() [amvx] ->
devfreq_set_target() -> devfreq_update_target() -> devfreq_monitor(),
panicking the kernel ~8s after boot.

The driver already attaches an SCMI performance-domain device
(ctx->opp_pmdomain, via dev_pm_domain_attach_by_name(dev, "perf")) at
probe time -- the same mechanism the 7.2/rc5 tree's mvx_dev.c already
uses for devfreq target-setting. Port that implementation back:
mvx_devfreq_target() now finds the exact OPP on the perf-domain device
and programs the SCMI firmware performance level directly via
dev_pm_genpd_set_performance_state(), never touching clk_round_rate.
mvx_devfreq_get_cur_freq() and the busy-time report in
mvx_devfreq_get_dev_status() switch from clk_get_rate(ctx->clk) to a
tracked ctx->current_freq field (matching rc5), since ctx->clk is the
VPU functional clock, not the DVFS control, and reading it doesn't
reflect the actual devfreq-selected performance level anyway.

ctx->opp_pmdomain and its device_link were already present and
correctly initialized in this driver -- only the three functions using
the older clk-rate-based approach needed to change.

Upstream-Status: Pending
Signed-off-by: Jason Perlow <jperlow@gmail.com>
---
--- a/drivers/media/platform/cix/dev/mvx_dev.c	2026-07-27 23:05:22
+++ b/drivers/media/platform/cix/dev/mvx_dev.c	2026-07-27 23:05:58
@@ -143,6 +143,7 @@
     struct devfreq_dev_profile devfreq_profile;
     struct devfreq *devfreq;
     unsigned long target_freq;
+    unsigned long current_freq;
 };
 
 /**
@@ -494,6 +495,7 @@
     struct dev_pm_opp *opp;
     unsigned long pre_freq;
     unsigned long target_freq = *freq;
+    unsigned int pstate;
     int ret;
 
     opp = devfreq_recommended_opp(dev, freq, flags);
@@ -503,10 +505,31 @@
     }
     dev_pm_opp_put(opp);
 
-    pre_freq = ctx->clk ? clk_get_rate(ctx->clk) : 0;
-    ret = dev_pm_opp_set_rate(dev, *freq);
-    if (!ret)
+    /*
+     * The OPPs originate from the SCMI performance domain.  Program that
+     * domain with the firmware performance level corresponding to the
+     * devfreq-selected frequency; ctx->clk is the separately managed VPU
+     * functional clock and is not the DVFS control.
+     */
+    opp = dev_pm_opp_find_freq_exact(ctx->opp_pmdomain, *freq, true);
+    if (IS_ERR(opp)) {
+        dev_err(dev, "Failed to get perf-domain OPP for %lu Hz\n", *freq);
+        return PTR_ERR(opp);
+    }
+
+    pstate = dev_pm_opp_get_level(opp);
+    dev_pm_opp_put(opp);
+    if (pstate == U32_MAX) {
+        dev_err(dev, "No performance level for %lu Hz\n", *freq);
+        return -EINVAL;
+    }
+
+    pre_freq = READ_ONCE(ctx->current_freq);
+    ret = dev_pm_genpd_set_performance_state(ctx->opp_pmdomain, pstate);
+    if (!ret) {
+        WRITE_ONCE(ctx->current_freq, *freq);
         atomic_set(&mvx_log_perf.freq, *freq);
+    }
 
     MVX_LOG_PRINT(&mvx_log_dev, MVX_LOG_DEBUG, "%s() target=%ld, previous=%ld, current=%ld.",
                     __func__, target_freq, pre_freq, *freq);
@@ -518,7 +541,7 @@
 {
     struct mvx_dev_ctx *ctx = dev_get_drvdata(dev);
 
-    *freq = ctx->clk ? clk_get_rate(ctx->clk) : 0;
+    *freq = READ_ONCE(ctx->current_freq);
     MVX_LOG_PRINT(&mvx_log_dev, MVX_LOG_DEBUG, "%s() %ld", __func__, *freq);
 
     return 0;
@@ -530,7 +553,7 @@
     struct mvx_dev_ctx *ctx = dev_get_drvdata(dev);
 
     update_freq(ctx);
-    stat->current_frequency = ctx->clk ? clk_get_rate(ctx->clk) : 0;
+    stat->current_frequency = READ_ONCE(ctx->current_freq);
     stat->busy_time = ctx->target_freq;
     stat->total_time = stat->current_frequency;
 
@@ -632,6 +655,8 @@
     }
 
     profile->max_state = i;
+    profile->initial_freq = profile->freq_table[0];
+    ctx->current_freq = profile->initial_freq;
     profile->polling_ms = 100;
     profile->target = mvx_devfreq_target;
     profile->get_dev_status = mvx_devfreq_get_dev_status;
