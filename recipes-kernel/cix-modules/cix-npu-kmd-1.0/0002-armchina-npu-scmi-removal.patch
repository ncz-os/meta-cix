From dbdbfc8868d69ae0934515159769913d98522cdc Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Sat, 23 May 2026 11:29:01 -0400
Subject: [PATCH 2/2] armchina-npu: replace scmi_device_* helpers removed in
 BSP kernel

Sky1 BSP kernel removed scmi_device_get_freq / set_freq /
opp_table_parse. Replace with:
  set_freq -> dev_pm_opp_set_rate; cache priv->last_freq
  get_freq -> cached read
  opp_table_parse -> no-op (genpd auto-attaches OPPs from DT/ACPI)

Signed-off-by: Jason Perlow <jperlow@gmail.com>
---
 driver/armchina-npu/include/cix_sky1_soc.h |  1 +
 driver/armchina-npu/sky1/sky1.c            | 17 +++++++++++++++++
 2 files changed, 18 insertions(+)

diff --git a/driver/armchina-npu/include/cix_sky1_soc.h b/driver/armchina-npu/include/cix_sky1_soc.h
index c60b5b9..ce4f6e7 100644
--- a/driver/armchina-npu/include/cix_sky1_soc.h
+++ b/driver/armchina-npu/include/cix_sky1_soc.h
@@ -17,6 +17,7 @@ struct cix_aipu_priv {
 	struct device_link *opp_dl;
 	struct devfreq_dev_profile devfreq_profile;
 	struct devfreq *devfreq;
+	unsigned long last_freq;	/* cached perf-domain freq (replaces scmi_device_get_freq) */
 };
 
 int sky1_npu_pm_runtime_get_sync(struct device *dev);
diff --git a/driver/armchina-npu/sky1/sky1.c b/driver/armchina-npu/sky1/sky1.c
index 39d1c42..835fe51 100644
--- a/driver/armchina-npu/sky1/sky1.c
+++ b/driver/armchina-npu/sky1/sky1.c
@@ -14,11 +14,28 @@
 #include <linux/devfreq.h>
 #include <linux/devfreq-event.h>
 #include <linux/scmi_protocol.h>
+#include <linux/pm_opp.h>
 #include <linux/debugfs.h>
 #include <linux/acpi.h>
 #include "armchina_aipu_soc.h"
 #include "cix_sky1_soc.h"
 
+/*
+ * Sky1 BSP kernel removed scmi_device_get_freq / set_freq /
+ * opp_table_parse. Replacement path:
+ *   set_freq -> dev_pm_opp_set_rate; cache f in priv->last_freq
+ *   get_freq -> read cached priv->last_freq
+ *   opp_table_parse -> no-op (genpd auto-attaches OPPs from DT/ACPI)
+ */
+#define scmi_device_get_freq(_pd) \
+	(cix_aipu_priv ? cix_aipu_priv->last_freq : 0UL)
+#define scmi_device_set_freq(_pd, _f) \
+	({ int _ret = dev_pm_opp_set_rate((_pd), (_f)); \
+	   if (!_ret && cix_aipu_priv) cix_aipu_priv->last_freq = (_f); \
+	   _ret; })
+#define scmi_device_opp_table_parse(_pd)	(0)
+
+
 #define NPU_CORE_ACPI_NAME_PREFIX       "CRE"
 
 int CIX_NPU_PD_NUM = CIX_NPU_PD_MAX_NUM;
-- 
2.51.0

