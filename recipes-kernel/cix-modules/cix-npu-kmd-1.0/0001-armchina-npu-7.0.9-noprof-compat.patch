From 2c486e4eda9ba02967c5fd6a8c03801472e55b5a Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Sat, 23 May 2026 11:29:01 -0400
Subject: [PATCH 1/2] armchina-npu: noprof symbol compat for OOT build

Vendor BSP kernel exports only *_noprof variants of mem-profiler hot
path symbols. The in-tree alloc_tag.h wrapper chain doesn't reach this
OOT module across all TUs. Apply via -include from KCFLAGS to force
every TU to pick up the alias.

Signed-off-by: Jason Perlow <jperlow@gmail.com>
---
 driver/armchina-npu/include/noprof_compat.h | 35 +++++++++++++++++++++
 1 file changed, 35 insertions(+)
 create mode 100644 driver/armchina-npu/include/noprof_compat.h

diff --git a/driver/armchina-npu/include/noprof_compat.h b/driver/armchina-npu/include/noprof_compat.h
new file mode 100644
index 0000000..77a54b5
--- /dev/null
+++ b/driver/armchina-npu/include/noprof_compat.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Force *_noprof aliases for mem-profiler hot-path entry symbols.
+ *
+ * The Sky1 vendor BSP kernel exports only the _noprof variants of these
+ * symbols. The in-tree alloc_tag.h chain that papers over the rename
+ * doesn't reach this OOT module reliably across all TUs, so we force the
+ * alias directly. Apply this compat header via -include from KCFLAGS so
+ * every translation unit picks it up.
+ */
+#ifndef __NOPROF_COMPAT_H__
+#define __NOPROF_COMPAT_H__
+
+#undef alloc_workqueue
+#define alloc_workqueue(...)    alloc_workqueue_noprof(__VA_ARGS__)
+
+#undef kmem_cache_create
+#define kmem_cache_create(...)  kmem_cache_create_noprof(__VA_ARGS__)
+
+#undef kmem_cache_alloc
+#define kmem_cache_alloc(...)   kmem_cache_alloc_noprof(__VA_ARGS__)
+
+#undef vzalloc
+#define vzalloc(...)            vzalloc_noprof(__VA_ARGS__)
+
+#undef __mutex_init
+#define __mutex_init(...)       __mutex_init_noprof(__VA_ARGS__)
+
+#undef dev_pm_opp_add
+#define dev_pm_opp_add(...)     dev_pm_opp_add_noprof(__VA_ARGS__)
+
+#undef kmalloc_trace
+#define kmalloc_trace(...)      kmalloc_trace_noprof(__VA_ARGS__)
+
+#endif /* __NOPROF_COMPAT_H__ */
